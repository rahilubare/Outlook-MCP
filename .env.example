# --- Windows PC (bridge + MCP) ---
WEBSITE_URL=https://mail.yoursite.com
INGEST_TOKEN=change-me-long-random
# --- Website server ---
# INGEST_TOKEN=<same value>
DASHBOARD_USER=admin
